# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to git.

# From Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase "service_role" key -- SECRET, server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password your friend will use to log into /admin
ADMIN_PASSWORD=choose-a-strong-password

# Random long string used to sign the admin login cookie. Generate one with:
# openssl rand -hex 32
ADMIN_SECRET=replace-with-a-long-random-string
